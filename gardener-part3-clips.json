"14": [
"91bf6232-4347-434b-8eb3-fd82dc88a6bc",
"J",
"I'm hiding. Don't tell anyone."
],
"15": [
"78053e35-eeea-4ba0-b89b-438cb2983b39",
"E",
"Hiding's free back here."
],
"16": [
"6d7ac0a3-dc7c-4fd7-8022-e4b2a2bc4392",
"J",
"Those roses. My mother's been through three gardeners in five years, and none of them could grow anything like that."
],
