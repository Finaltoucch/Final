"D",
"Who are you?"
],
"4": [
"afc16a35-f007-4dc5-859a-7d5090191600",
"E",
"I live out back. I've carried trays at more weddings than you've had hot dinners."
],
"5": [
"291c7988-bb97-4a06-9f28-7c1406ffae28",
"D",
"You're an angel."
],
"6": [
"0f0c675e-cbb1-4ea0-8b34-3cd2e3a38099",
"E",
"Don't tell my daughter."
],
"7": [
"df6d4769-8782-4aab-9051-367feaec34ef",
"C",
"Still no father tonight, Hannah?"
],
"8": [
